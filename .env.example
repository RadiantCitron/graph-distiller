# =============================================================================
# graph-distiller .env.example — 공개용 템플릿 (이 파일은 커밋해도 됨)
# =============================================================================
# 사용법: 복사해서 `.env` 로 저장한 뒤 실제 키·모델을 넣는다.
#   Windows:  copy .env.example .env
# 초심자 강의(첨부): docs/design/attachments/env-beginner.md
# 원칙: ADR-029 — 설정 변수에 심하리만치 주석. 본문 문서는 첨부로 설명.
# =============================================================================


# ==============================================================================
# 1. 인증 — OpenRouter API 키 (유료. git에 올리지 말 것 → .env 에만)
# ==============================================================================
# OPENROUTER_API_KEY: LLM·임베딩 호출 자격증명. config.py가 ChatOpenAI에 주입.
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL: OpenAI 호환 엔드포인트. 기본은 OpenRouter.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# ==============================================================================
# 2. 모델 — Phase별 역할이 다름 (slug = provider/model)
# ==============================================================================
# EXTRACTION_MODEL / SYNTHESIS_MODEL:
#   - python cli_rag_compiler.py  → CLI 필수 (--extraction-model / --synthesis-model).
#     컴파일러는 이 env 값을 무시한다 (ADR-053).
#   - pytest / deprecated shim(src/main.py) → 여전히 env에서 읽을 수 있음.
# 없으면 models_required=True 경로에서 프로세스 즉시 종료.
# 단가(요율): 소스에 하드코드하지 않음. 런 시작 시 OpenRouter GET /models
#   를 1회 호출해 FREE / $ / UNKNOWN 을 표시한다 (ADR-031).

# EMBEDDING_MODEL: Phase 1 의미 청킹용 벡터 모델 (chunker.py)
#   컴파일러는 --embedding-model 로 덮어쓸 수 있음 (선택).
EMBEDDING_MODEL=openai/text-embedding-3-small

# EXTRACTION_MODEL (“추출”): Phase 2 엔티티/관계 추출 + Phase 4 챕터 제목(Planner)
#   호출이 청크 수만큼 나므로 보통 저가·고속 모델을 둔다.
#   컴파일 시: 같은 slug를 --extraction-model 에 복사해서 넘긴다.
EXTRACTION_MODEL=openai/gpt-4o-mini

# SYNTHESIS_MODEL (“집필/합성”): Phase 4 Synthesizer가 챕터 본문(책 글)을 씀
#   글 품질·인용 정확도에 직접 영향. 보통 EXTRACTION보다 비싸다.
#   컴파일 시: 같은 slug를 --synthesis-model 에 복사해서 넘긴다.
SYNTHESIS_MODEL=google/gemini-2.5-flash-lite


# ==============================================================================
# 3. 경로 (선택) — 비우면 프로젝트 루트 기본 경로
# ==============================================================================
# RAW_MEMOS_DIR=data/raw_memos
# CHECKPOINT_DIR=data/checkpoints
# CODEX_OUTPUT_DIR=output/codex
# ERRORS_LOG_PATH=output/errors.log
# PROMPTS_DIR: 프롬프트 통제실(ADR-059) — Phase 2/4 시스템 프롬프트 .md 파일 위치.
#   여기 있는 파일을 읽어 런타임에 주입한다(코드 재컴파일/재시작 불필요, 재실행만 하면 됨).
#   파일이 없거나 비어 있으면 각 모듈에 남아있는 하드코딩 fallback 상수로 안전하게 강등된다.
# PROMPTS_DIR=data/prompts
# RULES_DIR: 규칙 통제실(ADR-060) — Phase 2/4 판정 규칙 .toml 파일 위치.
#   (동의어 병합 임계값·RepoMap 비율·플래너 유출 마커·Verifier 문장분리 패턴 등)
#   파일이 없으면 코드 기본값으로 안전하게 강등되지만, 파일이 있는데 값이 잘못되면
#   (범위 초과·정규식 오류 등) LLM 호출 전에 즉시 중단되고 이유가 출력된다.
# RULES_DIR=data/rules


# ==============================================================================
# 4. 파이프라인 수치 노브 (19개) — [DEPRECATED in .env, ADR-077]
# ==============================================================================
# [중요 — ADR-077]:
#   아래 19개 수치·논리 노브의 정본은 `workspace.toml`의 `[pipeline]` 섹션(또는 프로필 TOML)입니다.
#   .env에 작성된 값은 하위 호환성을 위해 계속 읽히지만(우선순위: 환경변수 > TOML > 기본값),
#   실행 시 `DeprecationWarning` 경고가 발생하며 향후 버전에서 제거될 예정입니다.
#   새 워크스페이스를 만들 때는 `workspace.toml` 내에 다음과 같이 작성하십시오:
#
#   [pipeline]
#   poc_top_chapters = 0
#   llm_concurrency = 20
#   max_chapter_retries = 3
#   max_chunk_tokens = 1000
#   semantic_breakpoint_percentile = 80
#   louvain_resolution = 0.5
#   min_community_size = 8
#   min_chapter_grounding_chunks = 2
#   repomap_small_keep_all_below = 10
#   repomap_snippet_chars = 2000
#   verify_citation_paragraph_ratio = 1.0
#   verify_citation_sentence_ratio = 0.25
#   canon_embed_merge = "off"
#   canon_embed_sim_threshold = 0.90
#   canon_embed_max_nodes = 2000
#   graph_max_nodes = 100000
#   graph_max_edges = 500000
#   graph_max_est_mb = 1024
#   graph_scale_on_exceed = "abort"
#
#   적용된 값과 5계층 출처는 다음 명령으로 LLM 호출 없이 표로 점검할 수 있습니다:
#   python cli_rag_compiler.py --explain [--workspace path/to/ws]

# --- 4.1 PoC / 런타임 가드레일 (DEPRECATED) ---
# POC_TOP_CHAPTERS: Phase 3→4 커뮤니티 캡 (ADR-055).
#   0 = 기본(프로덕션): 전 커뮤니티 = 챕터. 비용↑ 가능 → Pre-flight/예산 슬라이스 의존.
#   N>0 = PoC/스모크 opt-in: 노드 수 상위 N개만 집필. CLI: --poc-top N (TOML [pipeline] 권장)
# POC_TOP_CHAPTERS=0

# LLM_CONCURRENCY: Phase 2 동시 LLM 요청 수 상한 (extraction.py Semaphore) (TOML [pipeline] 권장)
# LLM_CONCURRENCY=20

# MAX_CHAPTER_RETRIES: “한 챕터를 Verifier FAIL 후 몇 번까지 다시 쓸까?” (TOML [pipeline] 권장)
#   초과 시 poisoned(책에서 제외). verifier.py
# MAX_CHAPTER_RETRIES=3

# --- 4.2 Phase 1 청킹 (DEPRECATED) ---
# MAX_CHUNK_TOKENS: 청크 최대 토큰. 초과 시 강제 분할 (chunker.py) (TOML [pipeline] 권장)
# MAX_CHUNK_TOKENS=1000
# SEMANTIC_BREAKPOINT_PERCENTILE: 의미 경계 민감도(높을수록 덜 자름) (TOML [pipeline] 권장)
# SEMANTIC_BREAKPOINT_PERCENTILE=80

# --- 4.3 Phase 3 커뮤니티 (ADR-025) (DEPRECATED) ---
# LOUVAIN_RESOLUTION: <1 이면 더 큰 커뮤니티 선호 (TOML [pipeline] 권장)
# LOUVAIN_RESOLUTION=0.5
# MIN_COMMUNITY_SIZE: 이보다 작은 커뮤니티는 이웃에 흡수 (TOML [pipeline] 권장)
# MIN_COMMUNITY_SIZE=8
# MIN_CHAPTER_GROUNDING_CHUNKS (ADR-057): 챕터(커뮤니티) 공유 고유 원문 청크 하한 (TOML [pipeline] 권장)
# MIN_CHAPTER_GROUNDING_CHUNKS=2

# --- 4.4 Phase 4 RepoMap / Verifier / 그래프 규모 (DEPRECATED) ---
# REPOMAP_SMALL_KEEP_ALL_BELOW: 노드 ≤N 이면 전부 유지 (TOML [pipeline] 권장)
# REPOMAP_SMALL_KEEP_ALL_BELOW=10
# REPOMAP_SNIPPET_CHARS: RepoMap에 넣는 원문 스니펫 최대 글자 (TOML [pipeline] 권장)
# REPOMAP_SNIPPET_CHARS=2000
# VERIFY_CITATION_PARAGRAPH_RATIO: 본문 문단 중 [DOC_ID] 필요 비율 (1.0=모든 문단) (TOML [pipeline] 권장)
# VERIFY_CITATION_PARAGRAPH_RATIO=1.0
# VERIFY_CITATION_SENTENCE_RATIO: 문장당 인용 비율 하한 (TOML [pipeline] 권장)
# VERIFY_CITATION_SENTENCE_RATIO=0.25
# CANON_EMBED_MERGE: Phase 2 Reduce 2 (embedding linker). Default off. (TOML [pipeline] 권장)
# CANON_EMBED_MERGE=off
# CANON_EMBED_SIM_THRESHOLD: cosine placeholder (0.90). (TOML [pipeline] 권장)
# CANON_EMBED_SIM_THRESHOLD=0.90
# CANON_EMBED_MAX_NODES: skip Reduce 2 above this node count (TOML [pipeline] 권장)
# CANON_EMBED_MAX_NODES=2000
# CANON_ALIAS_LEXICON_PATH: Phase 2 Reduce 3 domain alias lexicon JSON (경로 설정 유지, 프로필/워크스페이스 파일 단위 지원)
# CANON_ALIAS_LEXICON_PATH=data/lexicon/entity_aliases.json
# LEXICON_BOOTSTRAP_MODEL: 1-shot Reduce 3 generator (tests/tools/bootstrap_lexicon.py 전용)
# LEXICON_BOOTSTRAP_MODEL=openai/gpt-4o
# GRAPH_MAX_NODES / GRAPH_MAX_EDGES / GRAPH_MAX_EST_MB: Phase 2→3 규모 프리플라이트 (TOML [pipeline] 권장)
# GRAPH_MAX_NODES=100000
# GRAPH_MAX_EDGES=500000
# GRAPH_MAX_EST_MB=1024
# GRAPH_SCALE_ON_EXCEED: abort (default) | slice (TOML [pipeline] 권장)
# GRAPH_SCALE_ON_EXCEED=abort


# ==============================================================================
# 8. Real RAG DB (ADR-033) — knowledge-compression skeleton CLI
# ==============================================================================
# RAG_DB_URI: connection string for the labor-law RAG database (read-only SELECT on public.*).
#   Alias: DB_URI is also accepted if RAG_DB_URI is empty (legacy .env key).
#   Used by: python cli_rag_compiler.py --source db --sample --n-jo N --m-qna M
#            (models MUST be CLI args: --extraction-model --synthesis-model; .env slugs ignored)
#   Explicit full corpus: --source db --full-db (silent omit of sample sizes still FATAL, ADR-037)
#   After COUNT you MUST pass --sample --n-jo N --m-qna M  XOR  --full-db.
#   Never INSERT/UPDATE public.*. Exports go to output/rag_rebuild/<run_id>/.
#   Deprecated: python cli_rag_skeleton.py (forwards to compiler).
#   Never INSERT/UPDATE public.*. Exports go to output/rag_rebuild/<run_id>/.
#   Put secrets only in .env (not this file). Empty => file PoC path only; skeleton CLI exits.
#   Docs: docs/design/rag-rebuild-plan.md / rag-skeleton-impl-phases.md
#
# --- Leave-no-trace tent (ADR-040 / Phase E) — 초심자 ---
#   graph-distiller may CREATE schema "graph_distiller" (the tent) and load graph JSON there.
#   Neighbor tables (labor_law / labor_qna) stay SELECT-only — 원본은 오염되지 않음.
#   Re-load same run_id = replace (cascade delete that run, re-INSERT). Not a public wipe.
#   STATUS:   python cli_rag_status.py   OR  cli_rag_load.py --status  OR  cli_rag_skeleton.py --status
#   Cleanup:  python cli_rag_cleanup.py --schema -y   OR  … --cleanup-schema -y  (graph_distiller ONLY)
#   Console:  python cli_rag_tent.py   OR  … --interactive
#   Resume:   python cli_rag_tent.py --assess  /  --option I --resolve resume|wipe-run|wipe-schema
#   Prefer a DB role with public SELECT + graph_distiller CREATE only:
#     docs/design/attachments/graph-distiller-db-role.md  (DBA runs GRANT; app never GRANTs)
#   FAQ / test hygiene: docs/design/attachments/leave-no-trace-db.md
#                       docs/design/attachments/rag-db-schema.md
# RAG_DB_URI=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DB_URI=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# RAG_REBUILD_DIR: export root (default output/rag_rebuild)
# RAG_REBUILD_DIR=output/rag_rebuild


# ==============================================================================
# 9. Git 크기 게이트 (ADR-028) — 보안 검사 스크립트가 읽음
# ==============================================================================
# GIT_WARN_FILE_BYTES=10485760      # 10 MiB: 경고 + 사용자 승인
# GIT_HARD_MAX_FILE_BYTES=52428800  # 50 MiB: 절대 커밋 금지
# GIT_ALLOW_LARGE=1                 # 10~50 MiB 승인 후 일시 허용
